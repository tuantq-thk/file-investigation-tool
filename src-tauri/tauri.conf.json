{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "File Investigation Tool",
  "version": "0.4.9",
  "identifier": "com.tuantq.fileinvestigation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "File Investigation Tool",
        "width": 1440,
        "height": 940,
        "minWidth": 720,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
